{
    "name": "rayda-monorepo",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "echo 'Choose an app to run:' && echo '  npm run dev:remote     (port 3001)' && echo '  npm run dev:vendor     (port 3002)' && echo '  npm run dev:admin      (port 3003)' && echo '  npm run dev:employees  (port 3004)'",
        "dev:remote": "npm run dev --workspace=@rayda/rayda-remote",
        "dev:vendor": "npm run dev --workspace=@rayda/vendor-portal",
        "dev:admin": "npm run dev --workspace=@rayda/rayda-admin",
        "dev:employees": "npm run dev --workspace=@rayda/remote-employees",
        "build": "npm run build:remote && npm run build:vendor && npm run build:admin && npm run build:employees",
        "build:remote": "npm run build --workspace=@rayda/rayda-remote",
        "build:vendor": "npm run build --workspace=@rayda/vendor-portal",
        "build:admin": "npm run build --workspace=@rayda/rayda-admin",
        "build:employees": "npm run build --workspace=@rayda/remote-employees",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@internationalized/date": "^3.8.0",
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/typography": "^0.5.19",
        "@untitledui/country-flags": "^0.0.17",
        "@untitledui/file-icons": "^0.0.8",
        "@untitledui/icons": "^0.0.21",
        "input-otp": "^1.4.2",
        "motion": "^12.29.0",
        "next": "^16.1.4",
        "next-themes": "^0.4.6",
        "qr-code-styling": "^1.9.2",
        "react": "^19.2.3",
        "react-aria": "^3.46.0",
        "react-aria-components": "^1.15.1",
        "react-dom": "^19.2.3",
        "react-hotkeys-hook": "^5.2.3",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.0.1"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/node": "^24.10.9",
        "@types/react": "^19.2.9",
        "@types/react-dom": "^19.2.3",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "typescript": "^5.9.3"
    }
}
